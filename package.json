{
  "name": "appium-windows-driver",
  "version": "6.1.1",
  "description": "Appium bridge to WinAppDriver",
  "keywords": [
    "WinAppDriver",
    "appium",
    "windows"
  ],
  "bugs": {
    "url": "https://github.com/appium/appium-windows-driver/issues"
  },
  "license": "Apache-2.0",
  "author": "Appium Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/appium/appium-windows-driver.git"
  },
  "bin": {},
  "directories": {
    "lib": "lib"
  },
  "files": [
    "lib",
    "build/lib",
    "CHANGELOG.md",
    "LICENSE",
    "scripts"
  ],
  "type": "module",
  "main": "./build/lib/index.js",
  "types": "./build/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/lib/index.d.ts",
      "import": "./build/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && tsc --noEmit -p tsconfig.scripts.json",
    "dev": "tsc -b --watch",
    "clean": "tsc -b --clean",
    "lint": "oxlint -c oxlint.config.mjs .",
    "lint:fix": "oxlint -c oxlint.config.mjs --fix .",
    "format": "oxfmt -c oxfmt.config.mjs .",
    "format:check": "oxfmt -c oxfmt.config.mjs --check .",
    "prepare": "npm run build",
    "test": "node --test --enable-source-maps --test-timeout=60000 \"build/test/unit/**/*.test.js\"",
    "e2e-test": "npm run build && node --test --enable-source-maps --test-concurrency=1 --test-timeout=600000 \"build/test/e2e/**/*.test.js\""
  },
  "dependencies": {
    "asyncbox": "^6.0.1",
    "axios": "^1.16.0",
    "portscanner": "^2.2.0",
    "semver": "^7.6.3",
    "teen_process": "^4.0.4"
  },
  "devDependencies": {
    "@appium/oxc-config": "^1.1.0",
    "@appium/semantic-release-config": "^1.1.0",
    "@appium/tsconfig": "^1.2.0",
    "@appium/types": "^1.0.0-rc.1",
    "@types/node": "^26.0.0",
    "@types/portscanner": "^2.1.4",
    "@types/semver": "^7.8.0",
    "webdriverio": "^9.0.1"
  },
  "peerDependencies": {
    "appium": "^3.0.0-rc.2"
  },
  "optionalDependencies": {
    "koffi": "^3.0.2"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10"
  },
  "appium": {
    "driverName": "windows",
    "automationName": "Windows",
    "platformNames": [
      "Windows"
    ],
    "scripts": {
      "install-wad": "./scripts/install-wad.mjs"
    },
    "mainClass": "WindowsDriver"
  }
}
